<h1>Admin Panel</h1>
<a href="/dashboard">Back</a>

<h2>Users (NO PASSWORDS)</h2>
<table border="1">
  <tr>
    <th>ID</th>
    <th>Name</th>
    <th>Email</th>
  </tr>
  <% users.forEach(u=> { %>
    <tr>
      <td>
        <%= u.id %>
      </td>
      <td>
        <%= u.name %>
      </td>
      <td>
        <%= u.email %>
      </td>
    </tr>
    <% }) %>
</table>