<!DOCTYPE html>
<html>

<head>
  <title>Admin</title>
</head>

<body>
  <h1>Admin Panel</h1>
  <a href="/dashboard">Back</a>

  <h2>All Users (SENSITIVE DATA)</h2>
  <table border="1">
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Email</th>
      <th>Password (PLAINTEXT!)</th>
    </tr>
    <% users.forEach(u=> { %>
      <tr>
        <td>
          <%= u.id %>
        </td>
        <td>
          <%= u.name %>
        </td>
        <td>
          <%= u.email %>
        </td>
        <td style="color:red;">
          <%= u.password %>
        </td>
      </tr>
      <% }) %>
  </table>

  <h2>All Tasks</h2>
  <ul>
    <% tasks.forEach(t=> { %>
      <li>User <%= t.userId %>: <%= t.title %> - <%= t.description %>
      </li>
      <% }) %>
  </ul>
</body>

</html>